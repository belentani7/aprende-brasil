{
  "name": "aprende-brasil",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:api": "uvicorn api.main:app --reload --port 8000",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "uvicorn api.main:app --host 0.0.0.0 --port 8000",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "node scripts/run-python.mjs -m pytest",
    "verify": "npm run check && npm run test && npm run test:py && npm run build && npm run audit",
    "seed": "node scripts/run-python.mjs -m scripts.fetch_open_data && node scripts/run-python.mjs -m scripts.build_curriculum",
    "curriculum": "node scripts/build-curriculum.mjs",
    "curriculum:check": "node scripts/build-curriculum.mjs --check",
    "prebuild": "node scripts/build-curriculum.mjs",
    "precheck": "node scripts/build-curriculum.mjs",
    "pretest": "node scripts/build-curriculum.mjs",
    "predev": "node scripts/build-curriculum.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "node tools/aprende.mjs validate && node tools/aprende.mjs budget",
    "stats": "node tools/aprende.mjs stats",
    "test:a11y": "vitest run src/test/a11y.test.tsx"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
